{
    "name": "github",
    "version": "1.0.104",
    "private": true,
    "description": "A collection of top-level project documentation.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/.github/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/.github.git"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "scripts": {
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\""
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.113",
        "prettier": "^3.9.9"
    }
}
